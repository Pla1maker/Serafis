{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Serafis recovery catalog",
  "type": "object",
  "required": ["schema_version", "catalog_version", "generated_at", "publisher", "families", "solutions"],
  "additionalProperties": false,
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["en", "it"],
      "properties": {"en": {"type": "string", "maxLength": 4000}, "it": {"type": "string", "maxLength": 4000}},
      "additionalProperties": false
    },
    "https_url": {"type": "string", "pattern": "^https://[^\\s]{4,2000}$"},
    "nullable_https_url": {"oneOf": [{"$ref": "#/$defs/https_url"}, {"type": "null"}]}
  },
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "integer", "minimum": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "publisher": {"type": "string", "maxLength": 200},
    "notice": {"$ref": "#/$defs/i18n"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "retrieved_at"],
        "properties": {"name": {"type": "string"}, "url": {"$ref": "#/$defs/https_url"}, "retrieved_at": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "families": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"},
          "name": {"type": "string", "maxLength": 200},
          "aliases": {"type": "array", "items": {"type": "string", "maxLength": 200}},
          "reference": {"$ref": "#/$defs/https_url"}
        },
        "additionalProperties": false
      }
    },
    "solutions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["id", "family_ids", "name", "vendor", "official_page", "download_url", "official_domains", "version", "sha256", "signature", "compatibility", "limitations", "last_verified", "verification_status", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_.-]{1,120}$"},
          "family_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9_]{1,80}$"}},
          "variant": {"type": ["string", "null"], "maxLength": 200},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "vendor": {"type": "string", "minLength": 1, "maxLength": 200},
          "official_page": {"$ref": "#/$defs/https_url"},
          "howto_url": {"$ref": "#/$defs/nullable_https_url"},
          "download_url": {"$ref": "#/$defs/nullable_https_url"},
          "official_domains": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9.-]{3,253}$"}},
          "version": {"type": ["string", "null"], "maxLength": 100},
          "sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]},
          "sha256_source": {"type": ["string", "null"], "maxLength": 500},
          "signature": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {"enum": ["authenticode", "none", "unknown"]},
              "expected_signer_keywords": {"type": "array", "items": {"type": "string", "maxLength": 100}},
              "notes": {"type": "string", "maxLength": 1000}
            },
            "additionalProperties": false
          },
          "compatibility": {
            "type": "object",
            "properties": {
              "os": {"type": "array", "items": {"enum": ["windows", "linux", "macos", "android"]}},
              "variants": {"type": "array", "items": {"type": "string", "maxLength": 100}},
              "description": {"$ref": "#/$defs/i18n"}
            },
            "additionalProperties": false
          },
          "limitations": {"type": "array", "items": {"$ref": "#/$defs/i18n"}},
          "last_verified": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "verification_status": {"enum": ["listed_by_official_source", "verified_by_maintainer", "unverified"]},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/https_url"}}
        }
      }
    }
  }
}
