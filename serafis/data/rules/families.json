{
  "schema_version": 1,
  "rules_version": 1,
  "description": "Serafis identification rules. Each indicator has a weight between 0 and 1. Weights are deliberately conservative: an indicator alone never produces a 'strong' identification. Families are linked to catalog entries through catalog_family_ids. Indicators are based on widely documented, publicly reported characteristics; they can be spoofed and must be confirmed (see references).",
  "generic": {
    "note_name_regexes": [
      "(?i)^[!#_@+\\-\\s\\[\\(]*(how|help|read|readme|restore|recover|recovery|decrypt|decryption|instruction|instructions|unlock|files?|attention|warning|info)[^/\\\\]{0,60}\\.(txt|html?|hta|rtf|url)$"
    ],
    "note_name_keywords": ["decrypt", "restore", "recover", "readme", "read_me", "read-me", "how_to", "how to", "instruction", "ransom", "unlock", "encrypted"],
    "note_text_extensions": [".txt", ".html", ".htm", ".hta"],
    "generic_ransom_extensions": [".locked", ".encrypted", ".crypted", ".crypt", ".enc", ".encrypt", ".crypto", ".locky_encrypted", ".pay", ".ransom", ".rnsmwr"],
    "generic_extension_weight": 0.15,
    "ransom_note_content_keywords": ["your files have been encrypted", "your files are encrypted", "all your files", "decrypt", "bitcoin", "private key", "tor browser", ".onion", "i tuoi file sono stati crittografati", "ransom"]
  },
  "families": [
